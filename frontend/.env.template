# Firebase Configuration Example
# Copy this file to .env and fill in your Firebase project credentials
# Get these values from Firebase Console > Project Settings > General

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Admin Email Restriction
# Only this email can login via Google Sign-In
VITE_ADMIN_EMAIL=admin@yourstore.com

# Google Reviews (home page carousel)
# Both are required for live reviews; without them the carousel falls back to
# the Firestore `testimonials` collection.
#
# API key:  Google Cloud Console > APIs & Services > Credentials.
#           Enable "Places API (New)" and "Maps JavaScript API".
#           This key ships to the browser — restrict it by HTTP referrer to
#           your domains, and restrict it to those two APIs only.
# Place ID: https://developers.google.com/maps/documentation/places/web-service/place-id
#           (search your business name; it looks like ChIJ...)
#
# Note: Google returns a maximum of 5 reviews per place.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
VITE_GOOGLE_PLACE_ID=your_place_id_here

# Optional: Use Firebase Emulators for local development
# VITE_USE_FIREBASE_EMULATORS=true
